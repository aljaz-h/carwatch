# Copy this file to .env before running `docker compose up`.
# All values below are used by docker-compose.yml; sensible defaults are
# baked in so `docker compose up` works out of the box for a first try.

# --- Database -----------------------------------------------------------
POSTGRES_USER=carwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carwatch

# --- Initial admin account (created by the one-off `migrate` service) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too

# --- Web ------------------------------------------------------------------
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000

# --- Email notifications (optional; leave SMTP_HOST empty to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CarWatch <no-reply@carwatch.local>

# --- Worker tuning ---------------------------------------------------------
SCRAPE_CONCURRENCY=2
MATCH_CONCURRENCY=5
ALERT_CONCURRENCY=5
SCHEDULER_RECONCILE_MINUTES=5
