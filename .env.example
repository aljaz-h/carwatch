# ============================================================================
# CarWatch — environment configuration
#
#   1. cp .env.example .env
#   2. Generate a secret for POSTGRES_PASSWORD (./scripts/generate-secrets.sh
#      does this for you, or run: openssl rand -hex 32)
#   3. Adjust anything else you need below, then:
#        docker compose pull
#        docker compose up -d
#
# Required = the stack will not start correctly without a real value.
# Optional = safe to leave as-is; only change if you need that feature.
# ============================================================================

# --- Application --------------------------------------------------------
# Optional. Which published CarWatch release to run — used for BOTH the web
# and worker images, so they can never end up on mismatched versions.
#   latest        always run the newest published build (default)
#   0.3.1         pin to an exact release; `docker compose pull` then only
#                 fetches that tag, and `up -d` won't move past it until you
#                 change this again. See the README's Updating/Rollback
#                 sections before changing this on a running install.
CARWATCH_VERSION=latest

# Optional. Public URL CarWatch is reached at — used to build links in
# email/Discord notifications. Update once you have a domain or reverse
# proxy in front of CarWatch.
WEB_BASE_URL=http://localhost:3000

# Optional. Local port docker-compose publishes the web app on.
WEB_PORT=3000

# --- Authentication -------------------------------------------------------
# Nothing to configure here. CarWatch ships with no default admin account
# and no login secret. The first time you open the app you'll see a
# one-time setup screen to create the administrator account yourself.

# --- Database (PostgreSQL) ------------------------------------------------
# Optional.
POSTGRES_USER=carwatch
POSTGRES_DB=carwatch

# Required. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Redis ------------------------------------------------------------------
# Nothing to configure here. Redis is only reachable from the web/worker
# containers over the internal Docker network.

# --- Providers ------------------------------------------------------------
# Optional. Used only the first time the database is seeded, to set each
# provider's initial enabled/interval state. After that, change providers
# from Settings → Providers in the app — these variables are not read again.
AVTONET_ENABLED=true
AVTONET_INTERVAL_MINUTES=45

# Optional. Worker job concurrency and scheduling tuning; defaults are fine
# for a typical single-VPS deployment.
SCRAPE_CONCURRENCY=2
MATCH_CONCURRENCY=5
ALERT_CONCURRENCY=5
SCHEDULER_RECONCILE_MINUTES=5

# --- Notifications (optional) ---------------------------------------------
# Email (SMTP). Leave SMTP_HOST empty to disable email notifications —
# Discord notifications still work without this.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CarWatch <no-reply@carwatch.local>

# Discord notifications are configured per-account from Settings →
# Notifications (paste a Discord webhook URL) — no environment variable
# needed here.

# --- Diagnostics ------------------------------------------------------------
# Optional. How many days of provider scrape-run history to keep before the
# worker cleans up old rows.
PROVIDER_RUN_RETENTION_DAYS=30
