DATABASE_URL="postgresql://carwatch:carwatch@localhost:5432/carwatch?schema=public"
REDIS_URL="redis://localhost:6379"
NODE_ENV=development
WEB_BASE_URL="http://localhost:3000"

# Optional: leave SMTP_HOST unset to disable email alerts locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CarWatch <no-reply@carwatch.local>"

SCRAPE_CONCURRENCY=2
MATCH_CONCURRENCY=5
ALERT_CONCURRENCY=5
SCHEDULER_RECONCILE_MINUTES=5
