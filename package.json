{
  "name": "carwatch",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted used-car listing aggregator and monitoring platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @carwatch/web dev",
    "dev:worker": "pnpm --filter @carwatch/worker dev",
    "build": "pnpm --filter @carwatch/database generate && pnpm --filter @carwatch/web build && pnpm --filter @carwatch/worker build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @carwatch/database generate",
    "db:push": "pnpm --filter @carwatch/database push",
    "db:migrate": "pnpm --filter @carwatch/database migrate",
    "db:seed": "pnpm --filter @carwatch/database seed",
    "db:seed:essential": "pnpm --filter @carwatch/database seed:essential",
    "prepare": "true"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
