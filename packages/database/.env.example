DATABASE_URL="postgresql://carwatch:carwatch@localhost:5432/carwatch?schema=public"

# Used only by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# Used by both `pnpm db:seed` and `pnpm db:seed:essential` to set each
# provider's initial state. Optional — defaults shown below.
AVTONET_ENABLED=true
AVTONET_INTERVAL_MINUTES=45
