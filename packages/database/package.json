{
  "name": "@carwatch/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx --env-file=.env src/seed.ts",
    "seed:essential": "tsx src/seed-essential.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@carwatch/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/pg": "^8.11.10",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7"
  }
}
