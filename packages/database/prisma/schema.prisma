// CarWatch database schema
// Core principle: a Vehicle (the physical car/spec) is distinct from a Listing
// (an advertisement for that vehicle on a given marketplace). Multiple listings
// for the same physical car are linked via DuplicateMatch rather than merged.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  PLUGIN_HYBRID
  LPG
  CNG
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum DrivetrainType {
  FWD
  RWD
  AWD
}

enum BodyType {
  SEDAN
  HATCHBACK
  WAGON
  SUV
  COUPE
  CONVERTIBLE
  VAN
  PICKUP
  OTHER
}

enum SellerType {
  PRIVATE
  DEALER
  UNKNOWN
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  SOLD
  EXPIRED
  REMOVED
}

enum ProviderStatus {
  HEALTHY
  DEGRADED
  DOWN
  DISABLED
}

enum ScrapeRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
  CANCELLED
}

/// How a scrape run was triggered.
enum ScrapeRunTrigger {
  SCHEDULED
  MANUAL
}

/// Coarse classification of what went wrong during a scrape run, used to pick
/// a user-friendly message and to decide whether a failure is worth
/// surfacing prominently (e.g. HTTP_403 vs a one-off timeout).
enum ProviderErrorType {
  DNS_FAILURE
  CONNECTION_TIMEOUT
  REQUEST_TIMEOUT
  HTTP_FORBIDDEN
  HTTP_RATE_LIMITED
  HTTP_ERROR
  PARSER_STRUCTURE_MISMATCH
  PARSER_ANOMALY
  UNEXPECTED_RESPONSE
  DATABASE_ERROR
  NORMALIZATION_ERROR
  INTERNAL_ERROR
}

enum DuplicateMatchStatus {
  PENDING
  LIKELY
  CONFIRMED
  UNRELATED
}

enum AlertType {
  NEW_MATCH
  PRICE_DROP
  PRICE_INCREASE
  LISTING_RETURNED
  LISTING_REMOVED
  SIGNIFICANT_CHANGE
  GOOD_DEAL
}

enum AlertChannelType {
  DISCORD
  EMAIL
  TELEGRAM
  WEBPUSH
  NTFY
  GOTIFY
}

enum NotificationEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             Session[]
  savedSearches        SavedSearch[]
  watchlistItems       WatchlistItem[]
  notificationChannels NotificationChannel[]
  alertEvents          AlertEvent[]
  duplicateReviews     DuplicateMatch[]       @relation("DuplicateReviewer")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Vehicle / Listing core
// ---------------------------------------------------------------------------

model Vehicle {
  id String @id @default(cuid())

  manufacturer     String
  model            String
  generation       String?
  variant          String?
  year             Int?
  firstRegistration DateTime?

  fuelType      FuelType?
  transmission  TransmissionType?
  engineCapacity Int? // cc
  powerKw       Int?
  powerHp       Int?
  drivetrain    DrivetrainType?
  bodyType      BodyType?
  doors         Int?
  seats         Int?
  exteriorColor String?
  vin           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing?
  features VehicleFeature[]

  duplicateMatchesA DuplicateMatch[] @relation("VehicleA")
  duplicateMatchesB DuplicateMatch[] @relation("VehicleB")

  @@index([manufacturer, model])
  @@index([year])
  @@index([fuelType])
  @@index([transmission])
  @@index([bodyType])
  @@index([vin])
  @@map("vehicles")
}

model Feature {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  category String?

  vehicles VehicleFeature[]

  @@map("features")
}

model VehicleFeature {
  vehicleId String
  featureId String

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([vehicleId, featureId])
  @@index([featureId])
  @@map("vehicle_features")
}

model Provider {
  id                   String          @id @default(cuid())
  key                  String          @unique // e.g. "avto_net"
  name                 String
  baseUrl              String?
  isEnabled            Boolean         @default(true)
  scrapeIntervalMinutes Int            @default(60)
  config               Json            @default("{}")
  status               ProviderStatus  @default(HEALTHY)
  lastSuccessAt        DateTime?
  lastAttemptAt        DateTime?
  lastErrorAt          DateTime?
  lastError            String?
  /// Number of scrape runs that failed in a row (after exhausting their own
  /// retries), reset to 0 on the next successful run. Distinct from a single
  /// run's own BullMQ retry attempts.
  consecutiveFailures  Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  listings   Listing[]
  scrapeRuns ProviderScrapeRun[]

  @@map("providers")
}

model ProviderScrapeRun {
  id                 String           @id @default(cuid())
  providerId         String
  startedAt          DateTime         @default(now())
  finishedAt         DateTime?
  status             ScrapeRunStatus  @default(RUNNING)
  trigger            ScrapeRunTrigger @default(SCHEDULED)
  listingsDiscovered Int              @default(0)
  listingsNew        Int              @default(0)
  listingsUpdated    Int              @default(0)
  listingsUnchanged  Int              @default(0)
  listingsRemoved    Int              @default(0)
  errorsCount        Int              @default(0)

  /// User-friendly summary shown by default (e.g. "Provider response could
  /// not be parsed."). Technical details live in `errorDetail`.
  errorMessage       String?
  errorType          ProviderErrorType?
  /// Short technical detail for the collapsible "advanced" section (raw
  /// exception message, truncated). Never a full stack trace.
  errorDetail        String?
  httpStatus         Int?
  /// Attempt number for this specific execution (BullMQ's job.attemptsMade).
  retryCount         Int              @default(0)
  /// True when the run completed without a hard error but the result looks
  /// off (e.g. far fewer listings than usual) — the marketplace may have
  /// changed its HTML.
  isSuspicious       Boolean          @default(false)
  /// BullMQ job id, for correlating with live queue state.
  jobId              String?
  /// Small bounded array of {ts, level, message} events for this run.
  logs               Json?

  durationMs Int?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startedAt])
  @@index([providerId, status])
  @@map("provider_scrape_runs")
}

model Listing {
  id               String   @id @default(cuid())
  vehicleId        String   @unique
  providerId       String
  providerListingId String

  title       String
  description String?

  price         Int
  originalPrice Int?
  currency      String @default("EUR")

  mileage Int?

  sellerName  String?
  sellerType  SellerType @default(UNKNOWN)
  sellerPhone String?

  locationCity    String?
  locationRegion  String?
  locationCountry String?
  latitude        Float?
  longitude       Float?

  url    String
  images String[]

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  publishedAt DateTime?

  status      ListingStatus @default(ACTIVE)
  isAvailable Boolean       @default(true)

  rawMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  priceHistory   PriceHistory[]
  statusHistory  StatusHistory[]
  mileageHistory MileageHistory[]
  changeLogs     ListingChangeLog[]

  watchlistItems     WatchlistItem[]
  savedSearchMatches SavedSearchMatch[]
  alertEvents        AlertEvent[]

  duplicateMatchesA DuplicateMatch[] @relation("ListingA")
  duplicateMatchesB DuplicateMatch[] @relation("ListingB")

  @@unique([providerId, providerListingId])
  @@index([price])
  @@index([mileage])
  @@index([status])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([providerId])
  @@index([isAvailable])
  @@map("listings")
}

model PriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  price      Int
  recordedAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, recordedAt])
  @@map("price_history")
}

model StatusHistory {
  id         String        @id @default(cuid())
  listingId  String
  status     ListingStatus
  recordedAt DateTime      @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, recordedAt])
  @@map("status_history")
}

model MileageHistory {
  id         String   @id @default(cuid())
  listingId  String
  mileage    Int
  recordedAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, recordedAt])
  @@map("mileage_history")
}

model ListingChangeLog {
  id         String   @id @default(cuid())
  listingId  String
  field      String
  oldValue   String?
  newValue   String?
  recordedAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, recordedAt])
  @@map("listing_change_logs")
}

model DuplicateMatch {
  id            String               @id @default(cuid())
  listingAId    String
  listingBId    String
  vehicleAId    String
  vehicleBId    String
  status        DuplicateMatchStatus @default(PENDING)
  score         Float
  matchedFields Json
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  listingA Listing @relation("ListingA", fields: [listingAId], references: [id], onDelete: Cascade)
  listingB Listing @relation("ListingB", fields: [listingBId], references: [id], onDelete: Cascade)
  vehicleA Vehicle @relation("VehicleA", fields: [vehicleAId], references: [id], onDelete: Cascade)
  vehicleB Vehicle @relation("VehicleB", fields: [vehicleBId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DuplicateReviewer", fields: [reviewedById], references: [id])

  @@unique([listingAId, listingBId])
  @@index([status])
  @@map("duplicate_matches")
}

// ---------------------------------------------------------------------------
// Saved searches / watchlist / alerts
// ---------------------------------------------------------------------------

model SavedSearch {
  id     String @id @default(cuid())
  userId String
  name   String

  isActive Boolean @default(true)

  // Flexible filter payload (shared FilterCriteria type): manufacturer, model,
  // year range, price range, mileage range, fuel, transmission, power, body
  // style, location, providers, seller type, features, etc.
  required Json @default("{}")
  preferred Json @default("{}")
  excluded Json @default("{}")

  // Alert controls
  notifyNewMatch     Boolean @default(true)
  minMatchScore      Int     @default(70)
  maxPrice           Int?
  notifyPriceDrop    Boolean @default(true)
  minPriceDropAmount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches SavedSearchMatch[]
  alertEvents AlertEvent[]

  @@index([userId])
  @@map("saved_searches")
}

model SavedSearchMatch {
  id              String   @id @default(cuid())
  savedSearchId   String
  listingId       String
  score           Int
  scoreBreakdown  Json
  firstMatchedAt  DateTime @default(now())
  lastEvaluatedAt DateTime @default(now())

  savedSearch SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, listingId])
  @@index([listingId])
  @@map("saved_search_matches")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  note      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("watchlist_items")
}

model NotificationChannel {
  id        String            @id @default(cuid())
  userId    String
  type      AlertChannelType
  label     String
  config    Json
  isEnabled Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_channels")
}

model AlertEvent {
  id            String                   @id @default(cuid())
  userId        String
  type          AlertType
  savedSearchId String?
  listingId     String?
  dedupeKey     String                   @unique
  payload       Json
  status        NotificationEventStatus  @default(PENDING)
  channelResults Json?
  createdAt     DateTime                 @default(now())
  deliveredAt   DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@map("alert_events")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
